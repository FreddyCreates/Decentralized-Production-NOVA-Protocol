# ═══════════════════════════════════════════════════════════════════════════════
# NOVA Protocol — Sovereign Cloud Environment Configuration
# Copy to .env and customize for your deployment
# ═══════════════════════════════════════════════════════════════════════════════

# ── Deployment Mode ───────────────────────────────────────────────────────────
# Options: sovereign (full isolation), federated (multi-node), edge (minimal)
NOVA_DEPLOY_MODE=sovereign

# ── Network Configuration ─────────────────────────────────────────────────────
# For air-gapped deployments, set to "local"
# For federated sovereign clouds, set to "sovereign"
NOVA_NETWORK=local
NOVA_BIND_ADDRESS=0.0.0.0
NOVA_REPLICA_PORT=8080
NOVA_DASHBOARD_PORT=3000
NOVA_METRICS_PORT=9090
NOVA_API_PORT=8443

# ── Security ──────────────────────────────────────────────────────────────────
# Enable mTLS for government/enterprise deployments
NOVA_ENABLE_TLS=true
NOVA_TLS_CERT_PATH=/opt/nova/keys/server.crt
NOVA_TLS_KEY_PATH=/opt/nova/keys/server.key
NOVA_TLS_CA_PATH=/opt/nova/keys/ca.crt

# Enable mutual TLS (client certificate validation)
NOVA_ENABLE_MTLS=false
NOVA_CLIENT_CA_PATH=/opt/nova/keys/client-ca.crt

# ── Data Sovereignty ──────────────────────────────────────────────────────────
# All data remains within the sovereign boundary
NOVA_DATA_DIR=/opt/nova/data
NOVA_CONFIG_DIR=/opt/nova/config
NOVA_KEYS_DIR=/opt/nova/keys
NOVA_LOG_DIR=/opt/nova/data/logs

# Data residency jurisdiction (ISO 3166-1 alpha-2)
NOVA_DATA_JURISDICTION=XX
# Encryption at rest
NOVA_ENCRYPT_AT_REST=true
NOVA_ENCRYPTION_KEY_ID=sovereign-master-key

# ── Canister Configuration ────────────────────────────────────────────────────
# Maximum memory per canister (in bytes)
NOVA_CANISTER_MEMORY_LIMIT=8589934592
# Maximum number of concurrent canisters
NOVA_MAX_CANISTERS=100
# Cycle allocation per canister
NOVA_CYCLES_PER_CANISTER=10000000000000

# ── Governance ────────────────────────────────────────────────────────────────
# SNS DAO governance mode for sovereign deployments
NOVA_GOVERNANCE_MODE=sovereign
# Require multi-sig for critical operations
NOVA_REQUIRE_MULTISIG=true
NOVA_MULTISIG_THRESHOLD=3
NOVA_MULTISIG_TOTAL=5

# ── Monitoring & Audit ────────────────────────────────────────────────────────
NOVA_ENABLE_METRICS=true
NOVA_ENABLE_AUDIT_LOG=true
NOVA_AUDIT_LOG_PATH=/opt/nova/data/audit/audit.log
# Syslog forwarding for SIEM integration
NOVA_SYSLOG_FORWARD=false
NOVA_SYSLOG_HOST=
NOVA_SYSLOG_PORT=514

# ── Resource Limits ───────────────────────────────────────────────────────────
NOVA_MAX_CPU_CORES=8
NOVA_MAX_MEMORY_GB=32
NOVA_MAX_STORAGE_GB=500

# ── Backup & Recovery ─────────────────────────────────────────────────────────
NOVA_ENABLE_BACKUP=true
NOVA_BACKUP_SCHEDULE=0 2 * * *
NOVA_BACKUP_RETENTION_DAYS=90
NOVA_BACKUP_ENCRYPTION=true
NOVA_BACKUP_PATH=/opt/nova/data/backups
